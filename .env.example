# PostHog project API key (public, safe to expose). Falls back to the hardcoded key in src/components/posthog.astro if unset.
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where the SDK sends events. Defaults to /ingest (reverse-proxied via vercel.json) in production and https://us.i.posthog.com in dev.
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
